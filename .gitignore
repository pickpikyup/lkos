# ============================================================
# 私人数据：只留在本机，永远不进入 Git
# ============================================================
# 数据目录：文档索引数据库、问答记录、配置、评测题（含文档原文）、缓存
data/
# 运行日志、评测结果（含回答原文与出处）
logs/
# 任何位置的数据库文件及其备份
*.db
*.db-wal
*.db-shm
*.db.old-*
*.sqlite
*.sqlite3
# 命令行问答的输入历史
.history
# 文档本身：仓库里不应该出现任何真实文档（测试用的样本在运行时临时生成）
test-docs/
documents/
private/
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx
*.key
*.numbers
*.pages
# 密钥与本机环境
.env
*.pem

# ============================================================
# 开发环境与生成文件
# ============================================================
.venv/
.venv-linux/
.cache/
.pytest_tmp/
__pycache__/
*.pyc
*.egg-info/
.coverage
build/
dist/
.DS_Store
