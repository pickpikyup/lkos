#!/bin/bash
# 提交前检查：拦下私人数据（文档、数据库、数据目录、日志）。
# 启用：git config core.hooksPath scripts/git-hooks（scripts/setup_mac.sh 会自动设置）
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E -i \
  '(^|/)(data|logs|test-docs|documents|private)/|\.(db|db-wal|db-shm|sqlite3?|pdf|docx?|pptx?|xlsx?|key|numbers|pages)$|\.db\.old-|(^|/)\.env$' || true)
if [ -n "$bad" ]; then
  echo "提交被拦下：以下文件可能包含私人数据，不应进入 Git："
  echo "$bad" | sed 's/^/  /'
  echo "如果确定没问题，可以用 git commit --no-verify 跳过检查。"
  exit 1
fi
