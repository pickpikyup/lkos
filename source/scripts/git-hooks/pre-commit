#!/bin/bash
# 提交前检查：拦下私人数据（文档、数据库、数据目录、日志）。
# 启用：git config core.hooksPath source/scripts/git-hooks（source/scripts/setup_mac.sh 会自动设置）
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E -i \
  '(^|/)(data|logs|test-docs|documents|private)/|\.(db|db-wal|db-shm|sqlite3?|pdf|docx?|pptx?|xlsx?|key|numbers|pages)$|\.db\.old-|(^|/)\.env(\..*)?$|(^|/)models\.json$|\.(log|bundle|pem)$' || true)
if [ -n "$bad" ]; then
  echo "提交被拦下：以下文件可能包含私人数据，不应进入 Git："
  echo "$bad" | sed 's/^/  /'
  echo "如果确定没问题，可以用 git commit --no-verify 跳过检查。"
  exit 1
fi

# 暂存内容里像真实 API 密钥的字符串（Anthropic / OpenAI / Google / GitHub / AWS / 私钥）
keys=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -E -o \
  'sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20,}|sk-(proj-)?[A-Za-z0-9]{32,}|AIza[0-9A-Za-z_-]{35}|gh[pousr]_[A-Za-z0-9]{36}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----' | head -3 || true)
if [ -n "$keys" ]; then
  echo "提交被拦下：暂存的改动里有像 API 密钥的内容（只显示开头）："
  echo "$keys" | cut -c1-16 | sed 's/$/…/; s/^/  /'
  echo "密钥应只保存在 data/models.json（不进 Git）。确认是假数据可以用 git commit --no-verify 跳过。"
  exit 1
fi
